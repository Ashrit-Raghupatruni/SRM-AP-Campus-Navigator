# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
app/build/
.gradle/
captures/

# Android Studio / IntelliJ IDEA
*.iml
.idea/
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/kotlinc.xml
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Local configuration file (contains API keys and local SDK path)
local.properties

# Log files
*.log

# Android Profiling
*.hprof

# OS specific files
.DS_Store
Thumbs.db

# Documentation temporary screenshot captures
sdcard/

# Allow app logo and launcher icon pngs
!docs/images/*.png
!app/src/main/res/**/*.png
